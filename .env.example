# Copy to .env (never commit .env). Offline mode needs none of these: npm run offline

# Postgres the app connects to (least-privilege role created by db/001_schema.sql)
DATABASE_URL=postgres://readaroo_app:CHANGE_ME@localhost:5432/readaroo

# Owner account used only by npm run db:setup / db:seed / stripe:setup
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/readaroo

# Optional: password to set on the readaroo_app role during npm run db:setup
READAROO_APP_PASSWORD=

# Optional: Stripe TEST key (sk_test_...). Leave empty to simulate charges. Live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_METER_EVENT_NAME=readaroo_instant_borrow

# Server
PORT=3000
# 127.0.0.1 keeps the app private to your computer. Use 0.0.0.0 to open it to your network.
READAROO_HOST=127.0.0.1
